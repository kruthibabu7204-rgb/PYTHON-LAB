   "source": [
    "def sumation(my_list):\n",
    " sum=0\n",
    " for i in my_list:\n",
    "     sum=sum+i\n",
    " return sum\n",
    "my_list=[1,3,5,3]\n",
    "x=sumation(my_list)\n",
    "print(x)"
   ]
