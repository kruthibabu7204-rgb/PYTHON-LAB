    "### palindrome of a given string\n",
    "def pelendrome(text):\n",
    " if text==text[::-1]:\n",
    "     print(\"pelendrome\")\n",
    " else:\n",
    "    print(\"not a pelendrome\")\n",
    "word=input(\"enter a word\")\n",
    "pelendrome(word)\n",
    "    "
