    "text=\"python\"\n",
    "frequency={}\n",
    "\n",
    "for ch in text:\n",
    "    if ch in frequency:\n",
    "        frequency[ch]+=1\n",
    "    else:\n",
    "        frequency[ch]=1\n",
    "        print(frequency)"
