   "source": [
    "##write a program to calculate factorial of a number using recursion\n",
    "def fact(n):\n",
    "    if n==0 or n==1:\n",
    "        return 1\n",
    "    else:\n",
    "        return n * fact (n-1)\n",
    "n=int(input(\"enter n\"))\n",
    "result = fact(n)\n",
    "print(f\"Fact of {n} is: {result}\")"
   ]
